{
  "name": "ai-terminal-kb",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:antd": "vite build --config vite.antd.config.js",
    "preview": "node scripts/preview-server.js",
    "build:standalone": "npm run build:antd && node scripts/build-standalone.js",
    "check:changed": "node scripts/check-changed.js",
    "check": "node scripts/check-changed.js --all",
