    "clean": "node scripts/clean-workspace.js",
    "clean:deep": "node scripts/clean-workspace.js --deep"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@ant-design/x": "^2.8.0",
    "@tailwindcss/vite": "^4.3.2",
    "antd": "^6.5.1",
    "marked": "^18.0.6",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.2",
    "vite": "^8.1.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.4"
  }
}
